{
	"name": "@cxxi-lab/hubbyware-ui",
	"version": "0.5.1",
	"description": "Hubbyware's design system: React components, design tokens and fonts (formerly @cxxi-lab/hub-ui).",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": "./src/index.ts",
		"./theme.css": "./styles/theme.css",
		"./fonts.css": "./styles/fonts.css",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"styles",
		"fonts",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cxxi-lab/hubbyware-ui.git",
		"directory": "packages/hubbyware-ui"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	},
	"peerDependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@fortawesome/react-fontawesome": "^3.3.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.18.3",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.3.0"
	}
}
